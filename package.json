{
  "name": "dsh-cli-mode",
  "version": "0.1.0",
  "description": "把 DeepSeek Harness 会话变成终端可交互的 CLI:终端直接与 agent 对话、切换会话/模型/模式/权限模式、审批桥接、codex 式工作区。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "dsh-cli": "bin/dsh-cli.mjs"
  },
  "files": [
    "lib",
    "bin",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "check": "node --check lib/index.js && node --check bin/dsh-cli.mjs",
    "test": "node --test",
    "sync-source": "node scripts/sync-source.mjs"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cli",
    "cordis",
    "plugin",
    "terminal"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20.10"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://gitee.com/<your-id>/dsh-cli-mode.git"
  }
}
